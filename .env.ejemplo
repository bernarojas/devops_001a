# =============================================================================
#  Variables que consume docker-compose.prod.yml
#
#  Este archivo es la PLANTILLA y sí se versiona. El archivo real, .env, NO se
#  versiona: lo escribe la canalización en la máquina virtual a partir de los
#  secretos del repositorio, con permisos restringidos a su propietario.
#
#  Para probar la orquestación en una máquina local:
#      cp .env.ejemplo .env      y completar los valores
# =============================================================================

# Servidor de inicio de sesión del registro de contenedores, sin https://
# Ejemplo:  acrventasdevops.azurecr.io
REGISTRO=

# Etiqueta de las imágenes a desplegar.
#
# En la máquina virtual es SIEMPRE el número de compilación, nunca "latest".
# Desplegar con una etiqueta móvil sería cómodo y equivocado: dos máquinas que
# la descargaran en momentos distintos podrían terminar ejecutando versiones
# distintas, y no habría forma de saberlo.
ETIQUETA=

# Contraseña del usuario sa del motor.
#
# Requisitos de SQL Server: al menos 8 caracteres, con mayúsculas, minúsculas,
# dígitos y símbolos. No reutilizar la de desarrollo.
MSSQL_SA_PASSWORD=
