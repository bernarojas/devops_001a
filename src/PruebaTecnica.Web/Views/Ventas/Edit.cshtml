@model VentaInput
@{
    ViewData["Title"] = $"Editar venta #{Model.Id}";
}

<h2>Editar venta #@Model.Id</h2>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="mt-3" style="max-width: 900px;">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <partial name="_Formulario" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
