@model Producto
@{
    ViewData["Title"] = "Editar producto";
}

<h2>Editar producto</h2>

<form asp-action="Edit" asp-route-id="@Model.IdProducto" method="post" class="mt-3" style="max-width: 600px;">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="IdProducto" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="NombreProducto" class="form-label"></label>
        <input asp-for="NombreProducto" class="form-control" autocomplete="off" />
        <span asp-validation-for="NombreProducto" class="text-danger small"></span>
        <div class="form-text">
            Si cambia el nombre, el cambio se propaga automáticamente a todas las
            ventas de este producto.
        </div>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Activo" class="form-check-input" />
        <label asp-for="Activo" class="form-check-label"></label>
        <div class="form-text">
            Un producto inactivo conserva su historial pero no admite ventas nuevas.
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
