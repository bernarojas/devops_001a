@model Producto
@{
    ViewData["Title"] = Model.NombreProducto;
    int ventas = ViewBag.CantidadVentas ?? 0;
}

<h2>@Model.NombreProducto</h2>

<dl class="row mt-3" style="max-width: 600px;">
    <dt class="col-sm-5">Id</dt>
    <dd class="col-sm-7">@Model.IdProducto</dd>

    <dt class="col-sm-5">Estado</dt>
    <dd class="col-sm-7">
        @if (Model.Activo)
        {
            <span class="badge bg-success">Activo</span>
        }
        else
        {
            <span class="badge bg-secondary">Inactivo</span>
        }
    </dd>

    <dt class="col-sm-5">Fecha de creación</dt>
    <dd class="col-sm-7">@Model.FechaCreacion.ToString("dd-MM-yyyy HH:mm")</dd>

    <dt class="col-sm-5">Ventas asociadas</dt>
    <dd class="col-sm-7">@ventas.ToString("N0")</dd>
</dl>

<div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.IdProducto" class="btn btn-primary">Editar</a>
    <a asp-controller="Ventas" asp-action="Index" asp-route-Producto="@Model.NombreProducto"
       class="btn btn-outline-primary">Ver sus ventas</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
</div>
