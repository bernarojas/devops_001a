<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Genera el XML con los comentarios /// para que Swagger los muestre. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: "falta comentario XML en miembro público". Documentar cada
         propiedad de cada DTO agregaría ruido sin agregar información.
         CS1573: pide documentar el CancellationToken de cada acción. Ese
         parámetro lo inyecta el framework, no lo envía el cliente, y ni
         siquiera aparece en Swagger. -->
    <NoWarn>$(NoWarn);1591;1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

</Project>
